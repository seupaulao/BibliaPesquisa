<?xml version='1.0' encoding='utf-8'?>
<widget id="com.pjlaapps.bibliapesquisa" version="2.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>BibliaPesquisa</name>
    <description>
        Uma Biblia de Domínio Público baseada em tecnologia livre. 
    </description>
    <author email="pjlpapps@gmail.com" href="http://cordova.io">
        PJLAApps
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
        <allow-intent href="market:*" />
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>
    <preference name="EnableViewportScale" value="true" />
    <platform name="android">
        <icon monochrome="res/mdpi/monochrome.png" background="res/mdpi/background.png" density="mdpi" foreground="res/mdpi/foreground.png" />
        <icon monochrome="res/hdpi/monochrome.png" background="res/hdpi/background.png" density="hdpi" foreground="res/hdpi/foreground.png" />
    <icon monochrome="res/xhdpi/monochrome.png" background="res/xhdpi/background.png" density="xhdpi" foreground="res/xhdpi/foreground.png" />
    <icon monochrome="res/xxhdpi/monochrome.png" background="res/xxhdpi/background.png" density="xxhdpi" foreground="res/xxhdpi/foreground.png" />
    <icon monochrome="res/xxxhdpi/monochrome.png" background="res/xxxhdpi/background.png" density="xxxhdpi" foreground="res/xxxhdpi/foreground.png" />
    </platform>
</widget>
